# Cafe QR Menu — copy to .env and edit

PORT=5360
ADMIN_PASSWORD=change-me

# Required on Vercel / Render Free: Neon Postgres (pooled)
# https://console.neon.tech → Connection string (pooling ON)
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Local fallback only (ignored when DATABASE_URL is set; not available on Vercel)
