# Cafe QR Menu — copy to .env and edit

# Port the web app listens on
PORT=5360

# Admin password for the menu builder (change this!)
ADMIN_PASSWORD=change-me

# SQLite database location
DB_PATH=./data/menuly.db

# Public base URL of this install — QR codes point at BASE_URL/m/<slug>
# e.g. https://menu.yourcafe.com
BASE_URL=
